{
  "$schema_note": "Perfil consumidor LC Hub sobre tokens.vnext.json. Escopo CSS `[data-uds-profile=\"lc-hub\"]`. Fonte: profiles/LC_HUB_PROFILE_V2.md (2026-10-02). Não promove valores a defaults universais.",
  "meta": {
    "profile": "lc-hub",
    "source": "profiles/LC_HUB_PROFILE_V2.md",
    "themes": "light (dark não é requisito da rodada corrente, §1 do perfil)",
    "mirrors": [{"path": "adapters/keycloak/lc-hub/login/resources/css/uds.profile.lc-hub.css", "selector": ":root"}],
    "approval": {
      "HUMAN_APPROVED": ["type.explorer-*", "type.launcher-label", "launcher.*"],
      "CANDIDATE": ["accent.domain.*", "status.healthy (sucesso operacional)"],
      "note": "§7 do perfil: tipografia da árvore, geometria dos launchers, scroll, topbar e mobile aprovados; cor/contraste e fluidez de accordions NÃO homologados."
    }
  },
  "scalars": {
    "type.explorer-heading.size": "12px",
    "type.explorer-group.size": "15px",
    "type.explorer-group.weight": "600",
    "type.explorer-item.size": "14px",
    "type.explorer-icon.size": "18px",
    "type.card-title.size": "16px",
    "type.launcher-label.size": "14px",
    "type.meta.size": "12px",
    "launcher.height": "42px",
    "launcher.padding-inline": "12px",
    "launcher.padding-block": "6px",
    "launcher.icon-box": "30px",
    "launcher.gap": "8px",
    "type.nav.size": "14px"
  },
  "themes": {
    "light": {
      "accent.domain.apps": "#245BE8",
      "accent.domain.caps": "#7436DE",
      "accent.domain.activity": "#087F83",
      "accent.domain.audit": "#087FBA",
      "accent.domain.attention": "#B96A06",
      "status.healthy": "#13804B",
      "status.healthy.text": "#13804B"
    }
  },
  "contrastPairs": [
    {"fg": "accent.domain.apps", "bg": "surface.card", "min": 3.0, "themes": ["light"], "use": "ícone de domínio Aplicações"},
    {"fg": "accent.domain.caps", "bg": "surface.card", "min": 3.0, "themes": ["light"], "use": "ícone de domínio Capacidades"},
    {"fg": "accent.domain.activity", "bg": "surface.card", "min": 3.0, "themes": ["light"], "use": "ícone de domínio Atividade"},
    {"fg": "accent.domain.audit", "bg": "surface.card", "min": 3.0, "themes": ["light"], "use": "ícone de domínio Auditoria"},
    {"fg": "accent.domain.attention", "bg": "surface.card", "min": 3.0, "themes": ["light"], "use": "ícone de domínio Atenção"},
    {"fg": "accent.domain.apps", "bg": "surface.selected", "min": 3.0, "themes": ["light"], "use": "acento sobre item selecionado"},
    {"fg": "status.healthy.text", "bg": "surface.card", "min": 4.5, "themes": ["light"], "use": "texto de sucesso operacional"}
  ]
}
