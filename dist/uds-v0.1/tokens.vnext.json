{
  "$schema_note": "Extensão universal vNext (UNIVERSAL_DESIGN_VNEXT.md §2). Papéis semânticos sobre a extração de tokens.json, que permanece intocada. Valores '{sa.<chave>}' referenciam a extração; literais são valores NOVOS com status em 'provenance'. Gere o CSS com `python tools/uds_tokens.py build`.",
  "meta": {
    "extends": "tokens.json",
    "version": "0.1.0",
    "date": "2026-11-02",
    "status": "candidate",
    "statusNote": "Papéis = contrato vNext normativo. Valores literais novos = CANDIDATOS até homologação visual humana (vNext §2). Derivados ({sa.*}) herdam o status FATO da extração.",
    "cssPrefix": "--uds-"
  },
  "provenance": {
    "derived": "valor é referência literal a tokens.json (FATO da extração)",
    "candidate": "valor novo desta extensão; exige homologação",
    "fixed": "convenção técnica sem escolha estética (ex.: alvo de toque, backdrop)",
    "roles": {
      "text.muted": "candidate — sa.text-secondary já existe; muted escurecido para atingir 4.5:1 sobre surface.page (o #94A3B8 do hub fica abaixo de AA)",
      "border.interactive": "candidate — sa.border (#E2E8F0) tem ~1.2:1; limite de controle exige >= 3:1 (WCAG 1.4.11)",
      "status.unknown": "candidate — estado desconhecido neutro, distinto de healthy/empty (vNext invariante 6)",
      "status.*.text": "candidate — variante de texto com 4.5:1; o preenchimento de status mantém a cor extraída",
      "status.critical.bg": "candidate — fundo tonal de alerta de erro",
      "maturity.*": "candidate — vNext exige não reutilizar nomes de status operacional",
      "action.danger*": "candidate — branco sobre sa.negative (#DC2626) = 4.83; #B91C1C = 6.47 com margem para hover",
      "action.primary*": "candidate (dark) — sa.primary dark (#6D8CFF) com texto branco = 3.0, abaixo de AA",
      "surface.raised": "candidate (dark) — elevação perceptível sobre sa.surface",
      "surface.hover": "candidate (dark) — sa.surface-alt (#0F172A) é mais escuro que o card",
      "link-hover": "candidate (dark)",
      "shadow.*": "candidate",
      "backdrop": "fixed — sobreposição de overlay",
      "motion.*": "candidate — faixas de estudo do vNext §2, ainda não homologadas",
      "control.touch-min": "fixed — alvo mínimo para ponteiro grosso"
    }
  },
  "scalars": {
    "font.family": "-apple-system, \"Segoe UI\", system-ui, Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "font.family-mono": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
    "motion.fast": "140ms",
    "motion.normal": "200ms",
    "motion.panel": "240ms",
    "motion.easing": "cubic-bezier(0.2, 0, 0, 1)",
    "control.touch-min": "44px",
    "focus.ring-width": "2px",
    "focus.ring-offset": "2px",
    "border.width": "1px",
    "drawer.width": "360px",
    "explorer.width": "264px",
    "space.compact": "{uds.space.sm}",
    "space.comfortable": "{uds.space.md}"
  },
